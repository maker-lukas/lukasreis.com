---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  pixelated?: boolean;
}
const { title, description, image, link, pixelated = false } = Astro.props;
---

<a href={link} target="_blank" class="project">
  <div class="image">
    <img src={image} alt={title} class:list={[{ pixelated }]} />
  </div>
  <div>
    <h4>{title}</h4>
    <p class="description">{description}</p>
  </div>
</a>

<style>

  a {
    padding: 1ch;
  }

  .image {
    padding-bottom: 1ch;
  }

  .project {
    flex: 1;
    background: var(--dark-purple);
    border-radius: 10px;
    min-height: 350px;
    border: 3px solid var(--purple);
    cursor: pointer;
    transition: border-color 0.2s ease;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project:hover {
    border-color: var(--light-purple);
  }

  img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 5px;
    display: block;
  }

  img.pixelated {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  h4 {
    margin: 0 0 0.5ch;
  }

  .description {
    color: #D9D5DE;
    font-size: 14px;
  }
</style>
